(defcfg
  ;; Place your OS specific configurations here, see: https://github.com/jtroo/kanata

  ;; Tap-hold keys pressed within 150ms of the previous key are plain taps,
  ;; so Space mid-sentence never turns on the nav layer.
  tap-hold-require-prior-idle 150
)
;; The config below uses ANSI, if you are on ISO you will have to modify it.
(defsrc
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps      a    s    d    f    g    h    j    k    l    ;    '         ret
  lsft      z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc                 ralt rmet rctl
)

;; Plain QWERTY positions -- used with the Russian, Korean, Kazakh and Japanese
;; input sources, and for English while learning Gallium
(deflayer qwerty
  XX        brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap      a    s    d    f    g    h    j    k    l    ;    '         ret
  lsft      z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           @spc                ralt rmet rctl
)

;; Simply uncomment the Gallium version you wish to use.

;; Gallium Colstag (for column-staggered keyboards)
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    v    j    y    o    u    ,    [    ]    \
  @cap      n    r    t    s    g    p    h    a    e    i    /         ret
  lsft      x    q    m    w    z    k    f    '    ;    .    rsft
  lctl lmet lalt           @spc                ralt rmet rctl
)|#

;; Gallium Rowstag (v2) -- ACTIVE: made for row-staggered keyboards like the MacBook's
(deflayer gallium
  XX        brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    v    j    f    o    u    ,    [    ]    \
  @cap      n    r    t    s    g    y    h    a    e    i    /         ret
  lsft      x    q    m    w    z    k    p    '    ;    .    rsft
  lctl lmet lalt           @spc                ralt rmet rctl
)

;; Gallium Colstag angle modded
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    z    j    y    o    u    ,    [    ]    \
  @cap      n    r    t    s    v    p    h    a    e    i    /         ret
  lsft      q    m    w    g    x    k    f    '    ;    .    rsft
  lctl lmet lalt           @spc                ralt rmet rctl
)|#

;; Gallium Colstag angle modded QX swap reversed
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    z    j    y    o    u    ,    [    ]    \
  @cap      n    r    t    s    v    p    h    a    e    i    /         ret
  lsft      x    m    w    g    q    k    f    '    ;    .    rsft
  lctl lmet lalt           @spc                ralt rmet rctl
)|#

;; Gallium Rowstag angle modded
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    z    j    f    o    u    ,    [    ]    \
  @cap      n    r    t    s    v    y    h    a    e    i    /         ret
  lsft      q    m    w    g    x    k    p    '    ;    .    rsft
  lctl lmet lalt           @spc                ralt rmet rctl
)|#

;; Gallium Rowstag angle modded QX swap reversed
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    z    j    f    o    u    ,    [    ]    \
  @cap      n    r    t    s    v    y    h    a    e    i    /         ret
  lsft      x    m    w    g    q    k    p    '    ;    .    rsft
  lctl lmet lalt           @spc                ralt rmet rctl
)|#

(defalias
  ;; tap: backtick (grave), hold: toggle layer-switching layer while held
  grl (tap-hold 200 200 grv (layer-toggle layers))

  ;; Language keys: switch the kanata layer and send F13-F17, which skhd
  ;; (home.nix) turns into `macism <input source>`. kanata runs as root, so it
  ;; can't change the user's input source itself.
  en  (multi (layer-switch gallium) f13)
  enq (multi (layer-switch qwerty) f13)
  ru  (multi (layer-switch qwerty) f14)
  ko  (multi (layer-switch qwerty) f15)
  kk  (multi (layer-switch qwerty) f16)
  ja  (multi (layer-switch qwerty) f17)

  ;; Caps Lock: tap = Escape, hold = Control.
  ;; tap-hold-press turns into Control as soon as another key is pressed,
  ;; so fast chords like C-x don't wait for the timeout.
  cap (tap-hold-press 200 200 esc lctl)

  ;; Space: tap = space, hold = navigation layer.
  ;; tap-hold-release only picks the layer if another key is pressed and
  ;; released while Space is down, so rolling into the next letter stays a space.
  ;; Tap then quickly hold Space to auto-repeat spaces.
  spc (tap-hold-release 200 200 spc (layer-while-held nav))
)

;; Hold ` then press (physical QWERTY positions):
;;   1 = English (Gallium)   q = English (QWERTY)
;;   2 = Russian   3 = Korean   4 = Kazakh   5 = Japanese (all QWERTY)
;; Caps Lock position here gives you a real Caps Lock if you ever need it
(deflayer layers
  _         f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    @en  @ru  @ko  @kk  @ja  _    _    _    _    _    _    _    _
  _    @enq _    _    _    _    _    _    _    _    _    _    _    _
  caps _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; Navigation layer (hold Space). Keys are physical QWERTY positions,
;; so they work the same in every layer.
;;   y = Home   u = Page Down   i = Page Up   o = End
;;   h j k l = arrows   ; = Backspace   ' = Delete
;;   a s d f = Ctrl Option Cmd Shift (hold, combine with the keys above)
;;   z x c v b = Undo Cut Copy Paste Redo
(deflayer nav
  _         _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    home pgdn pgup end  _    _    _    _
  _    lctl lalt lmet lsft _    left down up   rght bspc del  _
  _    M-z  M-x  M-c  M-v  M-S-z _   _    _    _    _    _
  _    _    _              _              _    _    _
)
