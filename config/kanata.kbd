(defcfg
  ;; Place your OS specific configurations here, see: https://github.com/jtroo/kanata

)
;; The config below uses ANSI, if you are on ISO you will have to modify it.
(defsrc
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps      a    s    d    f    g    h    j    k    l    ;    '         ret
  lsft      z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc                 ralt rmet rctl
)

;; Plain QWERTY positions -- use this layer with the Russian and Korean input sources
(deflayer qwerty
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap      a    s    d    f    g    h    j    k    l    ;    '         ret
  lsft      z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc                 @nav rmet rctl
)

;; Simply uncomment the Gallium version you wish to use.

;; Gallium Colstag (for column-staggered keyboards)
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    v    j    y    o    u    ,    [    ]    \
  @cap      n    r    t    s    g    p    h    a    e    i    /         ret
  lsft      x    q    m    w    z    k    f    '    ;    .    rsft
  lctl lmet lalt           spc                 @nav rmet rctl
)|#

;; Gallium Rowstag (v2) -- ACTIVE: made for row-staggered keyboards like the MacBook's
(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    v    j    f    o    u    ,    [    ]    \
  @cap      n    r    t    s    g    y    h    a    e    i    /         ret
  lsft      x    q    m    w    z    k    p    '    ;    .    rsft
  lctl lmet lalt           spc                 @nav rmet rctl
)

;; Gallium Colstag angle modded
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    z    j    y    o    u    ,    [    ]    \
  @cap      n    r    t    s    v    p    h    a    e    i    /         ret
  lsft      q    m    w    g    x    k    f    '    ;    .    rsft
  lctl lmet lalt           spc                 @nav rmet rctl
)|#

;; Gallium Colstag angle modded QX swap reversed
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    z    j    y    o    u    ,    [    ]    \
  @cap      n    r    t    s    v    p    h    a    e    i    /         ret
  lsft      x    m    w    g    q    k    f    '    ;    .    rsft
  lctl lmet lalt           spc                 @nav rmet rctl
)|#

;; Gallium Rowstag angle modded
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    z    j    f    o    u    ,    [    ]    \
  @cap      n    r    t    s    v    y    h    a    e    i    /         ret
  lsft      q    m    w    g    x    k    p    '    ;    .    rsft
  lctl lmet lalt           spc                 @nav rmet rctl
)|#

;; Gallium Rowstag angle modded QX swap reversed
#|(deflayer gallium
  esc       brdn brup mctl lpad _    _    prev pp   next mute vold volu
  @grl       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       b    l    d    c    z    j    f    o    u    ,    [    ]    \
  @cap      n    r    t    s    v    y    h    a    e    i    /         ret
  lsft      x    m    w    g    q    k    p    '    ;    .    rsft
  lctl lmet lalt           spc                 @nav rmet rctl
)|#

(defalias
  ;; tap: backtick (grave), hold: toggle layer-switching layer while held
  grl (tap-hold 200 200 grv (layer-toggle layers))
  gal (layer-switch gallium)
  qwr (layer-switch qwerty)

  ;; Caps Lock: tap = Escape (for evil), hold = Control (for Emacs chords).
  ;; tap-hold-press turns into Control as soon as another key is pressed,
  ;; so fast chords like C-x don't wait for the timeout.
  cap (tap-hold-press 200 200 esc lctl)

  ;; Right Option: hold for the navigation layer
  nav (layer-while-held nav)
)

;; Hold ` then press: 1 = QWERTY (Russian/Korean), 2 = Gallium (English)
;; Caps Lock position here gives you a real Caps Lock if you ever need it
(deflayer layers
  _         f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    @qwr @gal _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  caps _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; Navigation layer (hold right Option). Arrows sit on the physical keys
;; where QWERTY has h j k l, so they work the same in every layer.
;;   y = Home   u = Page Down   i = Page Up   o = End
(deflayer nav
  _         _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    home pgdn pgup end  _    _    _    _
  _    _    _    _    _    _    left down up   rght _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
